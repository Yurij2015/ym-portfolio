# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX), from
# GA4 Admin → Data Streams. Analytics is only enabled when set.
NUXT_PUBLIC_GTAG_ID=

# Stable signing secret for OG image URLs (keeps shared links valid across
# redeploys). Generate with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=
